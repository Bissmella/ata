# Set the API key for whichever provider you drive ATA with (llm_config.provider).
# ATA reads these from the environment; keys never live in the input YAML.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# For the local `ollama` provider (OpenAI-compatible endpoint):
OLLAMA_BASE_URL=http://localhost:11434/v1
